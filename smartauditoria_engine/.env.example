# Variables de entorno — SmartAuditorIA Engine
# Copia este archivo a .env y rellena los valores

# ── Servidor ──────────────────────────────────────────────
ENGINE_HOST=0.0.0.0
ENGINE_PORT=8001
ENGINE_ENV=development         # development | staging | production
ENGINE_LOG_LEVEL=info          # debug | info | warning | error

# ── Seguridad ─────────────────────────────────────────────
ENGINE_API_KEY=<GENERAR_TOKEN_SECRETO>
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(32))"

# ── ChromaDB ──────────────────────────────────────────────
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_MODE=local              # local | server
CHROMA_PERSIST_DIR=./data/chromadb

# ── Colecciones ChromaDB ──────────────────────────────────
CHROMA_COLLECTION_ISO=iso_documents
CHROMA_COLLECTION_LEGAL=marco_legal_co

# ── Modelo de Embeddings ──────────────────────────────────
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
# Alternativa más ligera: all-MiniLM-L6-v2

# ── Pipeline RAG ──────────────────────────────────────────
RAG_TOP_K=5                    # Número de documentos recuperados
RAG_MIN_SCORE=0.5              # Umbral mínimo de relevancia (0.0 - 1.0)
RAG_MAX_SUGGESTIONS=10         # Máximo de sugerencias a retornar
